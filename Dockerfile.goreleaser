# Used only by the release pipeline, which has already cross-compiled the
# binary and passes a context containing just that. The repository's Dockerfile
# is the one to build from source.
#
# distroless/static suits docker-trim exactly: the binary is static, and the image it
# lands in has no shell and no package manager, which is the arrangement docker-trim
# spends its time recommending.
FROM gcr.io/distroless/static-debian12:nonroot

COPY docker-trim /usr/local/bin/docker-trim

WORKDIR /work
ENTRYPOINT ["docker-trim"]
