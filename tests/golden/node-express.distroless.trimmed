# ecosystem: node
# restructured: yes
# builder: node:18
# runtime: gcr.io/distroless/nodejs18-debian12:nonroot
# ---
# A typical bloated Node service: full node image, dev dependencies,
# build toolchain left in, npm cache shipped, running as root.
FROM node:18 AS builder

WORKDIR /app

RUN apt-get update \
 && apt-get install --no-install-recommends -y curl wget git build-essential python3 \
 && rm -rf /var/lib/apt/lists/*

COPY . .

RUN npm install \
 && npm cache clean --force
RUN npm run build

ENV NODE_ENV=production
# docker-trim(DT103): added by docker-trim so the runtime stage can be minimal
RUN npm prune --omit=dev

# docker-trim(DT100): runtime stage carries the application and nothing else
FROM gcr.io/distroless/nodejs18-debian12:nonroot
WORKDIR /app
# docker-trim(DT101): only the build output crosses the stage boundary
COPY --from=builder --chown=nonroot:nonroot /app /app
ENV NODE_ENV=production
EXPOSE 3000
# docker-trim(DT010): drop privileges before the process starts
USER nonroot:nonroot
# docker-trim(DT102): gcr.io/distroless/nodejs18-debian12:nonroot supplies the interpreter as its entrypoint
CMD ["dist/server.js"]
