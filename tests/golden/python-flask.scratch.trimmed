# ecosystem: python
# restructured: no
# reason: CPython needs libc and its own standard library; scratch has neither. Use --base distroless or --base alpine.
# ---
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install --no-install-recommends -y gcc g++ curl vim netcat-openbsd libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["gunicorn", "-b", "0.0.0.0:8000", "app:app"]
