# ecosystem: rust
# restructured: yes
# builder: rust:1.83
# runtime: gcr.io/distroless/cc-debian12:nonroot
# ---
FROM rust:1.83 AS builder

WORKDIR /build

RUN apt-get update \
 && apt-get install --no-install-recommends -y pkg-config libssl-dev curl \
 && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --release

# dtrim(DT100): runtime stage carries the application and nothing else
FROM gcr.io/distroless/cc-debian12:nonroot
WORKDIR /build
# dtrim(DT101): only the build output crosses the stage boundary
COPY --from=builder --chown=nonroot:nonroot /build/target/release/mytool /build/target/release/mytool
# dtrim(DT010): drop privileges before the process starts
USER nonroot:nonroot
ENTRYPOINT ["/build/target/release/mytool"]
